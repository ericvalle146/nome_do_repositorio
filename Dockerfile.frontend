# Dockerfile para o frontend (multi-stage build)
FROM node:20-alpine AS builder

WORKDIR /app

# Argumentos de build (variáveis VITE_* precisam estar no build)
ARG VITE_API_URL
ARG VITE_WEBHOOK_URL
ARG VITE_ALLOWED_HOSTS

# Define como variáveis de ambiente para o build
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_WEBHOOK_URL=${VITE_WEBHOOK_URL}
ENV VITE_ALLOWED_HOSTS=${VITE_ALLOWED_HOSTS}

# Copia arquivos de dependências
COPY package*.json ./
COPY tsconfig.json ./
COPY tsconfig.node.json ./
COPY vite.config.ts ./
COPY tailwind.config.ts ./
COPY postcss.config.js ./

# Instala todas as dependências (incluindo devDependencies para build)
RUN npm ci

# Copia o código fonte
COPY index.html ./
COPY src/ ./src/
COPY public/ ./public/

# Build da aplicação (as variáveis VITE_* serão embedadas no código)
RUN npm run build

# Stage 2: Servir o frontend buildado
FROM node:20-alpine

WORKDIR /app

# Instala serve e curl (para healthcheck)
RUN npm install -g serve && \
    apk add --no-cache curl

# Copia os arquivos buildados do stage anterior
COPY --from=builder /app/dist ./dist

# Expõe a porta do frontend
EXPOSE 4173

# Variável de ambiente
ENV PORT=4173

# Comando para servir o frontend (serve escuta em 0.0.0.0 por padrão em containers)
CMD ["serve", "-s", "dist", "-l", "4173"]

