# ============================================
# CONFIGURAÇÃO DOCKER - VERSIA
# ============================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp env.docker.example .env
# 2. Configure as variáveis abaixo
# 3. Execute: docker-compose -f docker-compose.prod.yml up -d --build
#
# IMPORTANTE: As variáveis VITE_* são embedadas durante o BUILD
# Se mudar essas variáveis, precisa rebuild: docker-compose -f docker-compose.prod.yml build --no-cache
# ============================================

# Porta do backend (container)
BACKEND_PORT=3001

# Porta do frontend (container)
FRONTEND_PORT=4173

# URL da API para o frontend
# IMPORTANTE: Esta URL é embedada durante o BUILD do frontend
# Para comunicação interna entre containers Docker, use: http://versia-backend:3001
# Para acesso externo (ngrok, domínio), use a URL pública
VITE_API_URL=http://versia-backend:3001

# URL do webhook do n8n
# IMPORTANTE: Esta URL é embedada durante o BUILD do frontend
VITE_WEBHOOK_URL=https://n8n.versa.tec.br/webhook/versa_saude_teste

# Hosts permitidos (opcional)
VITE_ALLOWED_HOSTS=chatinho.versatecnologia.com.br

# Logs de requisições no backend (true/false)
LOG_REQUESTS=false

