# ============================================
# CONFIGURAÇÃO DE PRODUÇÃO - VERSIA
# ============================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo: cp env.example .env
# 2. Execute: docker-compose -f docker-compose.prod.yml up -d --build
#
# IMPORTANTE: 
# - NUNCA commite o arquivo .env (já está no .gitignore)
# - Variáveis VITE_* são embedadas durante o BUILD do frontend
# - Se mudar VITE_*, precisa rebuild: docker-compose build --no-cache versia-frontend
# ============================================

# Porta interna do container backend (sempre 3001)
PORT=3001

# Porta externa mapeada no Docker (domínio aponta para 3002)
BACKEND_PORT=3002

# Porta do frontend
FRONTEND_PORT=4173

# URL da API do backend (domínio com HTTPS)
VITE_API_URL=https://chatinho.versatecnologia.com.br

# URL do webhook n8n que recebe mensagens do chat
VITE_WEBHOOK_URL=https://n8n.versa.tec.br/webhook/versa_saude_teste

# Hosts permitidos para o Vite
VITE_ALLOWED_HOSTS=chatinho.versatecnologia.com.br

# Logs de requisições (false = produção, true = debug)
LOG_REQUESTS=false