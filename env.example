# ============================================
# CONFIGURAÇÃO DE AMBIENTE - VERSIA
# ============================================
# 
# INSTRUÇÕES PARA DEPLOY:
# 1. Copie este arquivo para .env: cp env.example .env
# 2. Configure as variáveis abaixo conforme seu ambiente
# 3. NUNCA commite o arquivo .env no Git (já está no .gitignore)
#
# ============================================

# ============================================
# PORTA DO BACKEND (Servidor Express/API)
# ============================================
# Porta onde o servidor backend irá rodar
# Você pode usar qualquer porta disponível (ex: 3001, 4001, 5001, etc)
# 
# Exemplo de uso:
# - Local: 3001
# - Produção: 4001 ou 5001 (escolha uma porta que não conflite)
# 
# IMPORTANTE: 
# - Se mudar esta porta, também precisa atualizar VITE_API_URL
# - Verifique se a porta está livre: netstat -tuln | grep :PORTA
# - Use PORT ou BACKEND_PORT (ambos funcionam, PORT tem prioridade)
# ============================================
PORT=3001
# BACKEND_PORT=3001  # Alternativa a PORT

# ============================================
# PORTA DO FRONTEND (Servidor Vite Preview)
# ============================================
# Porta onde o frontend será servido em produção
# Usada pelo PM2 ao executar 'npm run preview'
# 
# Padrão: 4173 (padrão do Vite)
# Outras opções: 3002, 8080, etc
# ============================================
FRONTEND_PORT=4173

# ============================================
# URL DA API (Para o Frontend Conectar)
# ============================================
# URL completa da API que o frontend usará para conectar via SSE
# 
# DESENVOLVIMENTO:
# - Deixe vazio ou use: http://localhost:3001
# - O Vite usa proxy automático em desenvolvimento
# 
# PRODUÇÃO - OPÇÕES:
# 
# 1. COM NGROK (Recomendado para testes):
#    VITE_API_URL=https://81383d768225.ngrok-free.app
#    - Use a URL gerada pelo ngrok
#    - ATENÇÃO: URL muda a cada reinicialização do ngrok
#    - Use: ngrok http 3001 (ou a porta do seu backend)
# 
# 2. COM DOMÍNIO PRÓPRIO (Recomendado para produção):
#    VITE_API_URL=https://api.seudominio.com
#    - Configure DNS apontando para seu servidor
#    - Configure SSL/TLS (certificado HTTPS)
#    - Use proxy reverso (Nginx) se necessário
# 
# 3. COM IP PÚBLICO (Não recomendado, mas funciona):
#    VITE_API_URL=http://192.168.1.100:3001
#    - Use apenas em redes internas
#    - Não funciona se frontend for HTTPS (mixed content)
# 
# 4. MESMO SERVIDOR (Frontend e Backend juntos):
#    VITE_API_URL=http://localhost:3001
#    - Funciona apenas se frontend e backend estão no mesmo servidor
#    - Use quando ambos estão no mesmo servidor VPS
# 
# IMPORTANTE: 
# - Se o frontend for HTTPS, a API também precisa ser HTTPS (ou usar ngrok)
# - Se mudar a porta do backend (PORT), atualize aqui também
# - Sempre use HTTPS em produção se possível
# ============================================
VITE_API_URL=http://localhost:3001

# ============================================
# URL DO WEBHOOK (n8n ou outro serviço)
# ============================================
# URL completa do webhook que receberá as mensagens do usuário
# Esta URL é chamada quando o usuário envia uma mensagem no chat
# 
# Exemplo n8n:
# VITE_WEBHOOK_URL=https://n8n.versa.tec.br/webhook/versa_saude_teste
# 
# Exemplo outro serviço:
# VITE_WEBHOOK_URL=https://api.seudominio.com/webhook/chat
# ============================================
VITE_WEBHOOK_URL=https://n8n.versa.tec.br/webhook/versa_saude_teste

# ============================================
# HOSTS PERMITIDOS (Opcional)
# ============================================
# Lista de hosts permitidos para o Vite (separados por vírgula)
# Útil para desenvolvimento com ngrok ou domínios personalizados
# 
# Exemplo:
# VITE_ALLOWED_HOSTS=chatinho.versatecnologia.com.br,localhost,.ngrok-free.app
# ============================================
VITE_ALLOWED_HOSTS=chatinho.versatecnologia.com.br

# ============================================
# LOG DE REQUISIÇÕES (Opcional)
# ============================================
# Habilita logs detalhados de todas as requisições HTTP no backend
# 
# Valores:
# - true: Habilita logs (útil para debug)
# - false ou não definido: Desabilita logs (melhor performance)
# 
# IMPORTANTE: Desabilite em produção para melhor performance
# ============================================
LOG_REQUESTS=false

# ============================================
# EXEMPLOS DE CONFIGURAÇÃO PARA DEPLOY
# ============================================
#
# EXEMPLO 1: DESENVOLVIMENTO LOCAL
# ---------------------------------
# PORT=3001
# FRONTEND_PORT=4173
# VITE_API_URL=http://localhost:3001
# VITE_WEBHOOK_URL=https://n8n.versa.tec.br/webhook/versa_saude_teste
# VITE_ALLOWED_HOSTS=localhost
# LOG_REQUESTS=true
#
# EXEMPLO 2: PRODUÇÃO COM NGROK (Testes)
# ---------------------------------------
# PORT=3001
# FRONTEND_PORT=4173
# VITE_API_URL=https://81383d768225.ngrok-free.app
# VITE_WEBHOOK_URL=https://n8n.versa.tec.br/webhook/versa_saude_teste
# VITE_ALLOWED_HOSTS=chatinho.versatecnologia.com.br,.ngrok-free.app
# LOG_REQUESTS=false
#
# IMPORTANTE: URL do ngrok muda a cada reinicialização!
# Para pegar a nova URL: curl http://localhost:4040/api/tunnels
#
# EXEMPLO 3: PRODUÇÃO EM SERVIDOR VPS (Mesmo servidor)
# -----------------------------------------------------
# PORT=4001
# FRONTEND_PORT=3002
# VITE_API_URL=http://localhost:4001
# VITE_WEBHOOK_URL=https://n8n.versa.tec.br/webhook/versa_saude_teste
# VITE_ALLOWED_HOSTS=chatinho.versatecnologia.com.br
# LOG_REQUESTS=false
#
# EXEMPLO 4: PRODUÇÃO COM DOMÍNIO PRÓPRIO (Recomendado)
# ------------------------------------------------------
# PORT=3001
# FRONTEND_PORT=4173
# VITE_API_URL=https://api.seudominio.com
# VITE_WEBHOOK_URL=https://n8n.versa.tec.br/webhook/versa_saude_teste
# VITE_ALLOWED_HOSTS=chatinho.versatecnologia.com.br,api.seudominio.com
# LOG_REQUESTS=false
#
# ============================================
# COMO DEFINIR A PORTA NO DEPLOY
# ============================================
#
# OPÇÃO 1: Via arquivo .env (Recomendado)
# ----------------------------------------
# 1. Edite o arquivo .env
# 2. Defina: PORT=4001 (ou a porta que quiser)
# 3. Execute: pm2 restart versia-server --update-env
#
# OPÇÃO 2: Via variável de ambiente no PM2
# -----------------------------------------
# pm2 start server/index.js --name versia-server --update-env -- PORT=4001
#
# OPÇÃO 3: Via script de deploy
# ------------------------------
# BACKEND_PORT=4001 ./deploy.sh
#
# OPÇÃO 4: Exportar variável antes de iniciar
# ---------------------------------------------
# export PORT=4001
# pm2 start server/index.js --name versia-server --update-env
#
# ============================================
# NOTAS IMPORTANTES
# ============================================
# 
# 1. PORT vs BACKEND_PORT:
#    - Ambos funcionam, mas PORT tem prioridade
#    - Use PORT para simplicidade
#    - O código usa: process.env.PORT || process.env.BACKEND_PORT || 3001
#
# 2. VITE_API_URL:
#    - Em desenvolvimento: pode deixar vazio (usa proxy do Vite)
#    - Em produção: SEMPRE defina a URL completa
#    - Se usar HTTPS no frontend, a API também precisa ser HTTPS
#    - Se mudar PORT, atualize VITE_API_URL também
#
# 3. Portas:
#    - Escolha portas que não conflitem com outros serviços
#    - Verifique portas em uso: netstat -tuln | grep LISTEN
#    - Ou: ss -tlnp | grep :PORTA
#    - Portas comuns a evitar: 80, 443, 22, 3306, 5432, 8080
#
# 4. NGROK:
#    - URLs do ngrok mudam a cada reinicialização
#    - Use plano pago para URLs estáticas
#    - Ou configure um domínio próprio
#    - Para pegar URL atual: curl http://localhost:4040/api/tunnels
#
# 5. SEGURANÇA:
#    - Nunca commite o arquivo .env
#    - Use variáveis de ambiente no servidor quando possível
#    - Proteja URLs de webhook e APIs
#    - Use HTTPS em produção sempre que possível
#
# 6. APÓS MUDAR VARIÁVEIS:
#    - Se mudou PORT: pm2 restart versia-server --update-env
#    - Se mudou VITE_API_URL: npm run build && pm2 restart versia-web --update-env
#    - Sempre rebuild o frontend se mudou VITE_* variáveis
#
# ============================================